<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher background: the app's brand green (primary #58CC02) with a
    subtle vertical gradient toward primaryDark (#3F9700) for depth. Kept flat and
    edge-to-edge so the OS can mask it into any shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:startColor="#58CC02"
                android:endColor="#3F9700"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
