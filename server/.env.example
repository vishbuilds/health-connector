# Postgres connection string (Neon via Vercel Marketplace, or Supabase ap-southeast-2 for AU residency)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Shared secret the Android app sends as `Authorization: Bearer <INGEST_SECRET>` to /api/ingest.
# Generate with: openssl rand -base64 32
INGEST_SECRET=

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Full deployed URL, e.g. https://health-connector.vercel.app (use http://localhost:3000 for local dev)
BETTER_AUTH_URL=http://localhost:3000

# The only email allowed to sign in / be seeded as the single user account.
OWNER_EMAIL=vishaal.varma2000@gmail.com
