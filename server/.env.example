# Postgres connection string (Neon via Vercel Marketplace, or Supabase ap-southeast-2 for AU residency)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Shared secret the Android app sends as `Authorization: Bearer <INGEST_SECRET>` to /api/ingest.
# Generate with: openssl rand -base64 32
INGEST_SECRET=

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Full deployed URL, e.g. https://health-connector.vercel.app (use http://localhost:3000 for local dev)
BETTER_AUTH_URL=http://localhost:3000

# The only email allowed to sign in / be seeded as the single user account.
OWNER_EMAIL=vishaal.varma2000@gmail.com

# Food macros (food_macros_search tool) are served from the self-hosted `foods` table
# in this same DATABASE_URL — no external API or key. Populate it with:
#   npx tsx --env-file=.env.local scripts/setup-foods.ts
#   npx tsx --env-file=.env.local scripts/import-ausnut.ts   # AUSNUT 2023 (FSANZ, CC BY 3.0 AU)
#   npx tsx --env-file=.env.local scripts/import-off-au.ts   # Open Food Facts AU (ODbL)
